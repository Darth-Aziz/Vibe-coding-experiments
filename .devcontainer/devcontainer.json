{
  "name": "Tasheel (Next.js)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "postCreateCommand": "cd tasheel && npm install",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js (Tasheel)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"],
      "settings": {
        "eslint.workingDirectories": ["tasheel"]
      }
    }
  },
  "remoteUser": "node"
}
